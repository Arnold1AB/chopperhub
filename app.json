{
  "expo": {
    "name": "ChopperHub",
    "slug": "chopperhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "chopperhub",
    "icon": "./assets/images/chopperhub-logo.png",
    "ios": {
      "icon": "./assets/images/chopperhub-logo.png",
      "bundleIdentifier": "com.arnoldab.chopperhub"
    },
    "android": {
      "package": "com.arnoldab.chopperhub",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/chopperhub-logo.png",
        "backgroundColor": "#0F172A"
      }
    },
    "web": {
      "favicon": "./assets/images/chopperhub-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/chopperhub-logo.png",
          "backgroundColor": "#0F172A",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableBundleCompression": true,
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "enablePngCrunchInReleaseBuilds": true,
            "networkInspector": false,
            "useLegacyPackaging": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ChopperHub uses your photos when you choose a meal image to analyze.",
          "cameraPermission": "ChopperHub uses your camera to capture meal photos for analysis."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "ChopperHub uses your microphone to turn spoken meals into text.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "EXPO_PUBLIC_FIREBASE_API_KEY": "AIzaSyCVhXMn0YvbvR8BXPdRP0Rt3vsZEEZfFas",
      "EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN": "chopperhub-9d39b.firebaseapp.com",
      "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "chopperhub-9d39b",
      "EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET": "chopperhub-9d39b.firebasestorage.app",
      "EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "432377290151",
      "EXPO_PUBLIC_FIREBASE_APP_ID": "1:432377290151:web:5d5765a93963cc6881aa82",
      "EXPO_PUBLIC_CHOPPERHUB_API_URL": "https://chopperhub.netlify.app",
      "EXPO_PUBLIC_POSTHOG_KEY": "phc_uAocsSTDABsWhFwNp6kg4GJEC6dvqvcMnT8kioprOyUC",
      "EXPO_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com",
      "eas": {
        "projectId": "b8faad3a-84cc-4623-b1c2-eac2d0f2f18f"
      }
    },
    "owner": "arnoldab79"
  }
}
