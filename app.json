{
  "expo": {
    "name": "ChopperHub",
    "slug": "chopperhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "chopperhub",
    "icon": "./assets/images/chopperhub-logo.png",
    "ios": {
      "icon": "./assets/images/chopperhub-logo.png"
    },
    "android": {
      "package": "com.arnoldab.chopperhub",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/chopperhub-logo.png",
        "backgroundColor": "#0F172A"
      }
    },
    "web": {
      "favicon": "./assets/images/chopperhub-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/chopperhub-logo.png",
          "backgroundColor": "#0F172A",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableBundleCompression": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "networkInspector": false,
            "useLegacyPackaging": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
