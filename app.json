{
  "expo": {
    "name": "ChopperHub",
    "slug": "chopperhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "chopperhub",
    "icon": "./assets/images/chopperhub-logo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/chopperhub-logo.png"
    },
    "android": {
      "package": "com.arnoldab.chopperhub",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/chopperhub-logo.png",
        "backgroundColor": "#0F172A"
      }
    },
    "web": {
      "favicon": "./assets/images/chopperhub-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/auth-gb2.jpg",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "b8faad3a-84cc-4623-b1c2-eac2d0f2f18f"
      }
    },
    "owner": "arnoldab79"
  }
}
